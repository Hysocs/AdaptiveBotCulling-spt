<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>AdaptiveBotCulling</RootNamespace>
    <AssemblyName>AdaptiveBotCulling</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <!-- The release ZIP is a build output that Visual Studio's fast check
         cannot track, so always let MSBuild evaluate the packaging target. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\..\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\..\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.TerrainModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TerrainPhysicsModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.TerrainPhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.DirectorModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.DirectorModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.AIModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <AdaptiveBotCullingInstallDir>$(MSBuildProjectDirectory)\..\..\BepInEx\plugins\Hysocs-AdaptiveBotCulling</AdaptiveBotCullingInstallDir>
    <AdaptiveBotCullingPackageRoot>$(MSBuildProjectDirectory)\dist\AdaptiveBotCulling-$(Version)</AdaptiveBotCullingPackageRoot>
    <AdaptiveBotCullingPackageZip>$(MSBuildProjectDirectory)\dist\AdaptiveBotCulling-$(Version).zip</AdaptiveBotCullingPackageZip>
  </PropertyGroup>

  <Target Name="DeployAdaptiveBotCulling"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(AdaptiveBotCullingInstallDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(AdaptiveBotCullingInstallDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreateAdaptiveBotCullingReleasePackage"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Release' and '$(SkipPackage)' != 'true'">
    <RemoveDir Directories="$(AdaptiveBotCullingPackageRoot)" />
    <Delete Files="$(AdaptiveBotCullingPackageZip)" />

    <MakeDir Directories="$(AdaptiveBotCullingPackageRoot)\BepInEx\plugins\Hysocs-AdaptiveBotCulling" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(AdaptiveBotCullingPackageRoot)\BepInEx\plugins\Hysocs-AdaptiveBotCulling" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\LICENSE"
          DestinationFolder="$(AdaptiveBotCullingPackageRoot)\BepInEx\plugins\Hysocs-AdaptiveBotCulling" />

    <ZipDirectory SourceDirectory="$(AdaptiveBotCullingPackageRoot)"
                  DestinationFile="$(AdaptiveBotCullingPackageZip)"
                  Overwrite="true" />

    <Message Importance="high"
             Text="Adaptive Bot Culling release package created: $(AdaptiveBotCullingPackageZip)" />
  </Target>
</Project>
